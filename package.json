{
  "name": "packdev-agents",
  "version": "0.1.0",
  "private": true,
  "description": "Dependabot/Renovate PR triage: run packdev compat checks and report a verdict back on the PR.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --import tsx --test $(find test -name '*.test.ts')"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "packdev": "0.4.2",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/semver": "^7.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  }
}
