{
  "name": "@tchebit/packdev-agents",
  "version": "0.1.0",
  "description": "Dependabot/Renovate PR triage: run packdev compat checks and report a verdict back on the PR. Self-hosted CLI supports any forge (GitHub, Gitea, or a custom PROVIDER_MODULE) — no GitHub dependency required.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "packdev-agents": "./dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/cli/index.js",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --import tsx --test $(find test -name '*.test.ts')"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@octokit/rest": "^22.0.1",
    "packdev": "0.4.4",
    "semver": "^7.8.5"
  },
  "optionalDependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/semver": "^7.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  }
}
